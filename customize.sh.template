#!/system/bin/sh
# customize.sh - Module installation customization script
# Sourced by the module installer (Magisk, KernelSU family, APatch) after
# files are extracted. Uses only the portable installer contract
# (MODPATH, API, ARCH, ui_print, abort, set_perm_recursive).

# Directory replacement list for OverlayFS-based managers
# (KernelSU family, APatch). Their installers replace these stock
# directories with the module copies. Magisk ignores this variable and
# uses the .replace marker files shipped in the module instead.
REPLACE="
/__GMS_TARGET_DIR__
/__VENDING_TARGET_DIR__
/__GMS_LEGACY_TARGET_DIR__
/__GMS_LEGACY_PI_TARGET_DIR__
/__GMS_LEGACY_PIX_TARGET_DIR__
/__GMS_PROD_LEGACY_TARGET_DIR__
/__GMS_STD_TARGET_DIR__
/__VENDING_STD_TARGET_DIR__
/product/priv-app/GmsCore
/product/priv-app/PrebuiltGmsCore
/product/priv-app/Phonesky
"

print_banner() {
  ui_print "****************************************"
  ui_print " microG Minimal - Split-APK Suppressor  "
  ui_print " Target: Android 8.1+ Legacy/Go/Standard"
  ui_print "****************************************"
}

validate_sdk() {
  if [ -z "$API" ]; then
    ui_print "- Warning: API level not detected from environment."
    return 0
  fi

  if [ "$API" -lt 27 ]; then
    abort "! SDK $API detected. Android 8.1+ (API 27+) is required."
  fi

  if [ "$API" -gt 28 ]; then
    ui_print "- Notice: Detected API $API. Module supports Android 8.1+ across legacy, Go and standard layouts."
  fi
}

validate_arch() {
  if [ -z "$ARCH" ]; then
    ui_print "- Notice: Architecture not detected from environment."
    return 0
  fi

  if [ "$ARCH" != "arm" ] && [ "$ARCH" != "arm64" ]; then
    ui_print "- Warning: Architecture is $ARCH. Proven baseline is 32-bit ARM (armv7)."
  fi
}

check_stock_dir() {
  target_dir="$1"
  if [ -d "$target_dir" ]; then
    ui_print "- Detected stock package directory: $target_dir"
    return 0
  fi
  return 1
}

detect_stock_layout() {
  ui_print "- Inspecting device stock package layout..."
  detected=0

  for stock_path in \
    /__GMS_TARGET_DIR__ \
    /__VENDING_TARGET_DIR__ \
    /__GMS_LEGACY_TARGET_DIR__ \
    /__GMS_LEGACY_PI_TARGET_DIR__ \
    /__GMS_LEGACY_PIX_TARGET_DIR__ \
    /__GMS_PROD_LEGACY_TARGET_DIR__ \
    /product/priv-app/PrebuiltGmsCore \
    /product/priv-app/GmsCore \
    /__GMS_STD_TARGET_DIR__ \
    /product/priv-app/Phonesky \
    /__VENDING_STD_TARGET_DIR__
  do
    if check_stock_dir "$stock_path"; then
      detected=1
    fi
  done

  if [ "$detected" -eq 0 ]; then
    ui_print "- Notice: No stock GmsCore or Phonesky dirs detected on active partitions."
  fi
}

ensure_replace_marker() {
  target_dir="$1"
  marker_path="$target_dir/.replace"

  if [ -f "$marker_path" ]; then
    return 0
  fi

  ui_print "- Restoring missing .replace marker in $target_dir"
  mkdir -p "$target_dir"
  touch "$marker_path"
}

ensure_shipped_markers() {
  ensure_replace_marker "$MODPATH/__GMS_TARGET_DIR__"
  ensure_replace_marker "$MODPATH/__VENDING_TARGET_DIR__"
  ensure_replace_marker "$MODPATH/__GMS_LEGACY_TARGET_DIR__"
  ensure_replace_marker "$MODPATH/__GMS_LEGACY_PI_TARGET_DIR__"
  ensure_replace_marker "$MODPATH/__GMS_LEGACY_PIX_TARGET_DIR__"
  ensure_replace_marker "$MODPATH/__GMS_PROD_LEGACY_TARGET_DIR__"
  ensure_replace_marker "$MODPATH/__GMS_STD_TARGET_DIR__"
  ensure_replace_marker "$MODPATH/__VENDING_STD_TARGET_DIR__"
}

copy_payload() {
  src_file="$1"
  dst_dir="$2"
  dst_name="$3"
  component_name="$4"

  if [ ! -f "$src_file" ]; then
    abort "! Missing canonical payload at $src_file"
  fi

  ui_print "- Copying payload: $component_name..."
  mkdir -p "$dst_dir" || abort "! Failed to create directory: $dst_dir"
  cp "$src_file" "$dst_dir/$dst_name" || abort "! Failed to copy $component_name payload to $dst_dir/$dst_name"
}

copy_payloads() {
  gms_canonical="$MODPATH/__GMS_TARGET_DIR__/__GMS_TARGET_NAME__"
  vending_canonical="$MODPATH/__VENDING_TARGET_DIR__/__VENDING_TARGET_NAME__"

  # Legacy layout payloads
  copy_payload "$gms_canonical" "$MODPATH/__GMS_LEGACY_TARGET_DIR__" "__GMS_LEGACY_TARGET_NAME__" "GmsCore (Legacy)"
  copy_payload "$gms_canonical" "$MODPATH/__GMS_LEGACY_PI_TARGET_DIR__" "__GMS_LEGACY_PI_TARGET_NAME__" "GmsCore (Legacy Pi)"
  copy_payload "$gms_canonical" "$MODPATH/__GMS_LEGACY_PIX_TARGET_DIR__" "__GMS_LEGACY_PIX_TARGET_NAME__" "GmsCore (Legacy Pix)"
  copy_payload "$gms_canonical" "$MODPATH/__GMS_PROD_LEGACY_TARGET_DIR__" "__GMS_PROD_LEGACY_TARGET_NAME__" "GmsCore (Product Legacy)"

  # Standard layout payloads
  copy_payload "$gms_canonical" "$MODPATH/__GMS_STD_TARGET_DIR__" "__GMS_STD_TARGET_NAME__" "GmsCore (Standard)"
  copy_payload "$vending_canonical" "$MODPATH/__VENDING_STD_TARGET_DIR__" "__VENDING_STD_TARGET_NAME__" "Phonesky (Standard)"
}

verify_payload_apk() {
  apk_path="$1"
  component_name="$2"

  if [ -f "$apk_path" ]; then
    ui_print "- Found payload: $component_name ($(wc -c < "$apk_path" 2>/dev/null || echo "ok") bytes)"
    return 0
  fi

  abort "! Missing $component_name at $apk_path. Build module using scripts/build-module.sh."
}

verify_all_payloads() {
  # Go layout payloads
  verify_payload_apk "$MODPATH/__GMS_TARGET_DIR__/__GMS_TARGET_NAME__" "GmsCoreGo"
  verify_payload_apk "$MODPATH/__VENDING_TARGET_DIR__/__VENDING_TARGET_NAME__" "Phonesky (Go)"

  # Legacy layout payloads (Phonesky shared with Go layout)
  verify_payload_apk "$MODPATH/__GMS_LEGACY_TARGET_DIR__/__GMS_LEGACY_TARGET_NAME__" "GmsCore (Legacy)"
  verify_payload_apk "$MODPATH/__GMS_LEGACY_PI_TARGET_DIR__/__GMS_LEGACY_PI_TARGET_NAME__" "GmsCore (Legacy Pi)"
  verify_payload_apk "$MODPATH/__GMS_LEGACY_PIX_TARGET_DIR__/__GMS_LEGACY_PIX_TARGET_NAME__" "GmsCore (Legacy Pix)"
  verify_payload_apk "$MODPATH/__GMS_PROD_LEGACY_TARGET_DIR__/__GMS_PROD_LEGACY_TARGET_NAME__" "GmsCore (Product Legacy)"

  # Standard layout payloads
  verify_payload_apk "$MODPATH/__GMS_STD_TARGET_DIR__/__GMS_STD_TARGET_NAME__" "GmsCore (Standard)"
  verify_payload_apk "$MODPATH/__VENDING_STD_TARGET_DIR__/__VENDING_STD_TARGET_NAME__" "Phonesky (Standard)"
}

# Detects whether an active /data update exists for a package.
is_data_update() {
  pkg="$1"
  pkg_path="$(pm path "$pkg" 2>/dev/null)"

  if [ -z "$pkg_path" ]; then
    if command -v dumpsys >/dev/null 2>&1; then
      pkg_path="$(dumpsys package "$pkg" 2>/dev/null | grep "codePath=" || true)"
    fi
  fi

  case "$pkg_path" in
    */data/*) return 0 ;;
    *) return 1 ;;
  esac
}

# Removes /data update for a package using pm uninstall --user 0.
# Never clears package data, never touches system-base packages or GSF.
remove_package_data_update() {
  pkg="$1"

  if ! is_data_update "$pkg"; then
    return 0
  fi

  ui_print "********************************************************"
  ui_print "! WARNING: Conflicting /data update detected for $pkg"
  ui_print "! Removing /data update via 'pm uninstall --user 0 $pkg'..."
  ui_print "********************************************************"

  pm_out="$(pm uninstall --user 0 "$pkg" 2>&1 || true)"
  case "$pm_out" in
    *Success*)
      ui_print "- Successfully removed /data update for $pkg (user 0)."
      ;;
    *)
      ui_print "! Warning: Failed to remove /data update for $pkg (${pm_out:-unknown})."
      ui_print "! Manual cleanup recommended: pm uninstall --user 0 $pkg"
      ;;
  esac

  ui_print "! Notice: Only user 0 was uninstalled. Secondary users require manual cleanup."
}

remove_data_updates() {
  if ! command -v pm >/dev/null 2>&1; then
    ui_print "- Notice: pm not available in installer environment; skipping /data update check."
    return 0
  fi

  ui_print "- Checking for conflicting /data package updates..."
  # Stock GmsCore and Play Store package names are intrinsic domain constants.
  for pkg in com.google.android.gms com.android.vending; do
    remove_package_data_update "$pkg"
  done
}

# Disables a GApps overlay package for user 0 using pm uninstall --user 0.
# System partition files remain untouched and reversible via pm install-existing.
disable_gapps_overlay() {
  pkg="$1"
  family="$2"
  if [ -z "$pkg" ]; then
    return 0
  fi

  ui_print "********************************************************"
  ui_print "! WARNING: Conflicting $family overlay detected: $pkg"
  ui_print "! Disabling overlay for user 0 via 'pm uninstall --user 0 $pkg'..."
  ui_print "********************************************************"

  pm_out="$(pm uninstall --user 0 "$pkg" 2>&1 || true)"
  case "$pm_out" in
    *Success*)
      ui_print "- Successfully disabled overlay $pkg (user 0)."
      ui_print "! Notice: Only user 0 was disabled (system files untouched). Reversible via: pm install-existing $pkg"
      ;;
    *)
      ui_print "! Warning: Failed to disable overlay $pkg (${pm_out:-unknown})."
      ui_print "! Manual disable recommended: pm uninstall --user 0 $pkg"
      ;;
  esac
}

# Qualifies a candidate overlay package before disabling.
# Falls back to verifying codePath is outside /data when -s is unsupported.
qualify_gapps_candidate() {
  pkg="$1"
  family="$2"
  fallback="$3"

  if [ "$fallback" -eq 0 ]; then
    disable_gapps_overlay "$pkg" "$family"
    return 0
  fi

  pkg_path="$(pm path "$pkg" 2>/dev/null | tr -d '\r' || true)"
  case "$pkg_path" in
    */data/*)
      ui_print "! Warning: Skipping $pkg ($family): codePath is in /data (user app)."
      ;;
    package:/*|/*)
      disable_gapps_overlay "$pkg" "$family"
      ;;
    *)
      ui_print "! Warning: Skipping $pkg ($family): package path undeterminable."
      ;;
  esac
}

handle_gapps_candidate() {
  line="$1"
  fallback="$2"

  case "$line" in
    package:com.mtg.*)
      qualify_gapps_candidate "${line#package:}" "MindTheGapps" "$fallback"
      ;;
    package:com.nikgapps.overlay.*)
      qualify_gapps_candidate "${line#package:}" "NikGapps" "$fallback"
      ;;
    package:com.bitgapps.*)
      qualify_gapps_candidate "${line#package:}" "BitGapps" "$fallback"
      ;;
  esac
}

disable_gapps_overlays() {
  if ! command -v pm >/dev/null 2>&1; then
    ui_print "- Notice: pm not available in installer environment; skipping overlay check."
    return 0
  fi

  ui_print "- Checking for conflicting GApps overlay packages..."
  # Branded overlay package prefixes are intrinsic upstream identifiers.
  pkg_list="$(pm list packages -s 2>/dev/null || true)"
  fallback=0
  case "$pkg_list" in
    *package:*) ;;
    *)
      pkg_list="$(pm list packages 2>/dev/null || true)"
      fallback=1
      ;;
  esac

  echo "$pkg_list" | tr -d '\r' | while IFS= read -r line || [ -n "$line" ]; do
    handle_gapps_candidate "$line" "$fallback"
  done
}

apply_permissions() {
  ui_print "- Setting file permissions..."
  set_perm_recursive "$MODPATH" 0 0 0755 0644
}

main() {
  print_banner
  validate_sdk
  validate_arch
  detect_stock_layout

  # Ensure directory suppression markers exist for all layouts
  ensure_shipped_markers

  # Copy canonical payloads across target layouts
  copy_payloads

  # Validate packaged microG APKs for all layouts
  verify_all_payloads

  # Remove conflicting /data updates for stock packages if present
  remove_data_updates

  # Disable conflicting GApps overlays for user 0 if present (MindTheGapps, NikGapps, BitGapps)
  disable_gapps_overlays

  ui_print "- Configured microG permission and sysconfig overlays."

  apply_permissions

  ui_print "- microG Minimal installation completed."
  ui_print "- Stock packages suppressed via .replace overlays."
  ui_print "- Reboot device to activate microG services."
}

main
