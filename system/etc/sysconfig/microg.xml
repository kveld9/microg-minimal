<?xml version="1.0" encoding="utf-8"?>
<config>
    <!-- Allow microG GmsCore in battery saver, data saver, and unthrottled location -->
    <allow-in-power-save package="com.google.android.gms"/>
    <allow-in-data-usage-save package="com.google.android.gms"/>
    <allow-unthrottled-location package="com.google.android.gms"/>

    <!-- App link domain verification for microG and Play Store -->
    <app-link package="com.google.android.gms"/>
    <app-link package="com.android.vending"/>

    <!-- Cloud backup transport whitelist -->
    <backup-transport-whitelisted-service service="com.google.android.gms/.backup.BackupTransportService"/>
</config>
